{
  "name": "bunyadi-real-estate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "npm run db:init",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run db:init",
    "start": "next start",
    "lint": "next lint --dir app --dir components --dir lib --dir prisma --dir scripts",
    "db:init": "prisma migrate deploy && tsx scripts/bootstrap-admin.ts",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "14.2.35",
    "next-intl": "^4.14.2",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
