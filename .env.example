# --- Database (Neon Postgres) ---
# From your Neon project dashboard, copy TWO connection strings:
#
# 1. DATABASE_URL — the "Pooled connection" string (host contains "-pooler").
#    The running app uses this for every request.
# 2. DIRECT_URL — the "Direct connection" string (no "-pooler").
#    Prisma uses this only to run migrations, which need a plain session
#    connection that PgBouncer's transaction-mode pooling can't provide.
#
# Both include `?sslmode=require` by default on Neon — keep it.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Site ---
# Absolute base URL, no trailing slash. Required in production (canonical
# links, Open Graph images, sitemap).
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- Uploads ---
# Absolute path to the directory where admin-uploaded property images are
# stored. Defaults to ./storage/uploads (relative to the project root) if
# unset. On Render, point this at a mounted persistent Disk — see README.
# UPLOADS_DIR="/var/data/uploads"
